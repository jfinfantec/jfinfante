a:["$","section",null,{"className":"section","id":"preguntas","children":["$","div",null,{"className":"container section-grid","children":[["$","div",null,{"className":"section-no","aria-hidden":"true","children":"02"}],["$","div",null,{"children":[null,["$","h2",null,{"className":"section-title","children":"Antes de invertir"}],null,[["$","details",null,{"className":"content-detail","id":"proceso","children":[["$","summary",null,{"children":["Cómo empezamos y cómo se paga",["$","span",null,{"aria-hidden":"true","className":"detail-indicator"}]]}],["$","div",null,{"className":"detail-body","children":[["$","ol",null,{"className":"simple-steps","children":[["$","li",null,{"children":"Reviso oferta, perfil, activos, WhatsApp y capacidad comercial. Si la base aún no está preparada, el diagnóstico puede recomendar esperar; no exige un número fijo de meses de trabajo previo."}],["$","li",null,{"children":"Confirmamos por escrito objetivo, mercado, estructura y alcance."}],["$","li",null,{"children":"Concedes los permisos, entregas los materiales y pagas la gestión."}],["$","li",null,{"children":"Planeo, grabo y edito los dos videos. Apruebas piezas, textos y estructura antes de activar."}],["$","li",null,{"children":"Pagas a Meta el presupuesto recomendado y acordado. Los 30 días comienzan con la activación efectiva."}],["$","li",null,{"children":"Gestiono la campaña y, al cierre, recibes el informe."}]]}],["$","div",null,{"className":"payment-compact","children":["$","img",null,{"src":"/servicios-2026/brand/breb-infante.svg","alt":"Bre-B @infante3031"}]}],["$","p",null,{"children":"La gestión se paga al 100% por Bre-B — @infante3031. Es un valor independiente: no se descuenta del presupuesto de anuncios ni se cobra como porcentaje de ese presupuesto."}]]}]]}],["$","details",null,{"className":"content-detail","id":"$undefined","children":[["$","summary",null,{"children":["Qué se cotiza por separado",["$","span",null,{"aria-hidden":"true","className":"detail-indicator"}]]}],["$","div",null,{"className":"detail-body","children":[["$","p",null,{"children":"Otras marcas, ofertas, países, públicos completamente distintos, canales, campañas simultáneas, conjuntos adicionales, embudos, páginas de destino, catálogos e integraciones. También los creativos posteriores a los dos incluidos."}],["$","p",null,{"children":"No incluye presupuesto publicitario, mensajes, comentarios, seguimiento de conversaciones o leads, cierre de ventas, comunidad, publicación orgánica, historias ni administración del perfil."}],["$","p",null,{"children":"Tampoco incluye archivos editables, proyectos, recursos internos ni gestión después de los 30 días."}],["$","p",null,{"children":"No se garantizan ventas, conversaciones, costo por resultado, alcance ni rentabilidad."}]]}]]}],["$","details",null,{"className":"content-detail","id":"$undefined","children":[["$","summary",null,{"children":["Tus cuentas, accesos y permisos",["$","span",null,{"aria-hidden":"true","className":"detail-indicator"}]]}],["$","div",null,{"className":"detail-body","children":[["$","p",null,{"children":"La cuenta comercial, página, perfil, píxel, cuenta publicitaria y método de pago de Meta siguen siendo tuyos. También los dos videos finales después del pago total."}],["$","p",null,{"children":"Concedes permisos de socio o usuario desde Meta Business; no compartes contraseñas personales. Debes mantener pagos, verificaciones y permisos activos."}],["$","p",null,{"children":"Las revisiones y restricciones de Meta pueden afectar el calendario. Realizo los ajustes razonables dentro del alcance; la aprobación y continuidad de una cuenta restringida dependen de Meta."}]]}]]}],["$","details",null,{"className":"content-detail","id":"$undefined","children":[["$","summary",null,{"children":["Otras preguntas sobre Meta Ads",["$","span",null,{"aria-hidden":"true","className":"detail-indicator"}]]}],["$","div",null,{"className":"detail-body","children":["$","$Ld",null,{"items":[{"question":"¿Este servicio garantiza ventas?","answer":"No. La campaña busca generar oportunidades de conversación. Las ventas dependen también de la oferta, el precio, la reputación, el presupuesto, la competencia y la atención comercial del cliente."},{"question":"¿Cuánto dinero debo invertir en Meta?","answer":"Se recomienda después del diagnóstico. El presupuesto de anuncios es independiente de los $1.600.000 COP de gestión y se paga directamente a Meta."},{"question":"¿Qué pasa si nunca he hecho pauta?","answer":"Se revisa y configura el punto de partida necesario. No se activa automáticamente una secuencia fija de campañas; la estructura depende del diagnóstico y de los activos disponibles."},{"question":"¿Incluye los videos?","answer":"Sí. Incluye dos videos Ágil de hasta 20 segundos y una fecha de producción de hasta dos horas en La Ceja."},{"question":"¿Puedo pautar una oferta distinta con cada video?","answer":"No dentro del alcance publicado. Los dos creativos corresponden a la misma marca, oferta, objetivo, mercado y canal de WhatsApp."},{"question":"¿Usted responde los mensajes que lleguen?","answer":"No. La atención, el seguimiento de las conversaciones y el cierre comercial corresponden al cliente."},{"question":"¿Debo dar mi contraseña?","answer":"No. Los accesos se conceden desde Meta Business mediante permisos de socio o usuario."},{"question":"¿Qué pasa si Meta rechaza o bloquea la campaña?","answer":"Se realizan los ajustes razonables dentro del alcance, pero Meta controla sus revisiones y restricciones. No puede garantizarse la aprobación o continuidad de una cuenta restringida."},{"question":"¿El servicio se renueva automáticamente?","answer":"No. Termina al completar los 30 días de gestión y el informe final. Una continuación se acuerda y paga por separado."},{"question":"¿Cuándo no conviene contratarlo?","answer":"Cuando la oferta todavía no es clara, el perfil no genera confianza, WhatsApp no se atiende correctamente o el negocio no tiene capacidad para responder a nuevas oportunidades."}]}]}]]}]]]}]]}]}]
